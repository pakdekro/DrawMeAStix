    {
      "type": "note",
      "spec_version": "2.1",
      "id": "note--c0ra0000-0000-4000-8000-000000000054",
      "content": "Attribution to confirm: the infrastructure overlaps two clusters we already track, but the evidence stays thin. Do not publish as is.",
      "object_refs": [
        "intrusion-set--c0ra0000-0000-4000-8000-000000000001"
      ],
      "created": "2024-11-15T09:00:00.000Z",
      "modified": "2024-11-15T09:00:00.000Z"
    },
    {
      "type": "note",
      "spec_version": "2.1",
      "id": "note--c0ra0000-0000-4000-8000-000000000055",
      "content": "Whois: domain registered 6 days before the first detection, low-reputation registrar, name servers shared with the impersonation domain. See the attached capture.",
      "object_refs": [
        "domain-name--c0ra0000-0000-4000-8000-000000000017"
      ],
      "created": "2024-11-15T09:00:00.000Z",
      "modified": "2024-11-15T09:00:00.000Z"
    },
    {
      "type": "note",
      "spec_version": "2.1",
      "id": "note--c0ra0000-0000-4000-8000-000000000056",
      "content": "The binary is an obfuscated .NET dropper (double .pdf.exe extension). Persistence via a scheduled task, no deobfuscation in the sandbox.",
      "object_refs": [
        "file--c0ra0000-0000-4000-8000-000000000023"
      ],
      "created": "2024-11-15T09:00:00.000Z",
      "modified": "2024-11-15T09:00:00.000Z"
    },
    {
      "type": "note",
      "spec_version": "2.1",
      "id": "note--c0ra0000-0000-4000-8000-000000000057",
      "content": "Exploitation confirmed on initial access; the vendor patch had been available for 3 weeks at the time of the incident.",
      "object_refs": [
        "vulnerability--c0ra0000-0000-4000-8000-000000000012"
      ],
      "created": "2024-11-15T09:00:00.000Z",
      "modified": "2024-11-15T09:00:00.000Z"
    },
    {
      "type": "note",
      "spec_version": "2.1",
      "id": "note--c0ra0000-0000-4000-8000-000000000058",
      "content": "HTTP beacon every 60 s (10% jitter), User-Agent impersonating an update client. Proxy log extract attached.",
      "object_refs": [
        "url--c0ra0000-0000-4000-8000-000000000021"
      ],
      "created": "2024-11-15T09:00:00.000Z",
      "modified": "2024-11-15T09:00:00.000Z"
    },
