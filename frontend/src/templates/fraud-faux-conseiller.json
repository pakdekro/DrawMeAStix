      "prefill": { "x_mitre_id": "F1032", "mitre_framework": "mitre-f3" }
    },
    {
      "key": "t1621",
      "type": "attack-pattern",
      "label": "Getting past the second factor",
      "fixed": "Multi-Factor Authentication Request Generation",
      "prefill": { "x_mitre_id": "T1621" }
    },
    {
      "key": "f1025",
      "type": "attack-pattern",
      "label": "The transfer the victim makes",
      "fixed": "Electronic Funds Transfer: Peer-to-Peer Transfer",
      "prefill": { "x_mitre_id": "F1025.001", "mitre_framework": "mitre-f3" }
    }
